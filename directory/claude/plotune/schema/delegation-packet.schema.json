{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plotune:requirements:delegation-packet:1.0",
  "title": "Plotune Requirements delegated task packet",
  "description": "A bounded, human/audit-readable task brief, not a credential, permission grant or proof that an agent was launched.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "task_id",
    "workspace_id",
    "product_id",
    "objective",
    "scope",
    "permissions",
    "skill_paths",
    "deliverables",
    "return_contract"
  ],
  "properties": {
    "packet_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "session_run_id": {
      "type": "string"
    },
    "parent_task_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "revision"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "baseline_id": {
            "type": "string"
          }
        }
      }
    },
    "skill_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "guide_reference": {
      "type": "string",
      "description": "User-owned Guide or policy reference. No default maintainer link."
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "owned_records",
        "owned_paths"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "enum": [
              "analyze",
              "draft",
              "implement",
              "test",
              "record_evidence"
            ]
          }
        },
        "owned_records": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owned_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner_authorization_ref": {
          "type": "string",
          "description": "Real originating authorization reference if action requires it. This field is not itself an approval."
        }
      }
    },
    "return_contract": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checkpoint_artifact": {
      "type": "string",
      "description": "User-owned durable link/path; never insert tokens or secrets."
    }
  }
}
