  "enums": {
    "requirement_lifecycle_status": [
      "Draft",
      "In Review",
      "Approved",
      "Rejected",
      "Superseded",
      "Retired"
    ],
    "baseline_status": [
      "Draft",
      "Frozen",
      "Superseded"
    ],
    "verification_result": [
      "PASS",
      "FAIL",
      "NOT VERIFIED",
      "BLOCKED"
    ],
    "task_status": [
      "Backlog",
      "Running",
      "Blocked",
      "Review",
      "Done",
      "Cancelled"
    ],
    "finding_status": [
      "Open",
      "Under Review",
      "Accepted",
      "Rejected",
      "Resolved",
      "Closed"
    ],
    "finding_severity": [
      "Critical",
      "Major",
      "Minor",
      "Observation"
    ],
    "change_status": [
      "Proposed",
      "Under Analysis",
      "Awaiting Decision",
      "Approved",
      "Rejected",
      "Implementing",
      "Verification Pending",
      "Closed",
      "Cancelled"
    ],
    "change_impact_disposition": [
      "Open",
      "No Change",
      "Revise",
      "Add",
      "Retest",
      "Deferred",
      "Closed"
    ],
    "standard_profile_status": [
      "Proposed",
      "Active",
      "Inactive",
      "Retired"
    ]
  },
  "relationships": {
    "requirement_hierarchy": "parent_requirement_ids is a comma-separated ordered set of existing requirement IDs, allowing zero or more parents; requires DAG/no self links; hierarchy_level derived/read-only",
    "traceability": "typed references between records, or explicitly external artifacts; unrelated to hierarchical parent edges",
    "baseline_items": "immutable exact requirement revision plus text and acceptance snapshot after freeze",
    "verification": "requires exact requirement revision and actual evidence for PASS",
    "maturity": "workspace-owned optional definitions; do not assume an official L1-L6 scale",
    "review_findings": "finding links to real record ID/revision with evidence; records are proposals until reviewed; Closed requires disposition and rationale",
    "change_requests": "change requests track owner and decision separately from implementation/verification; approval cannot be inferred from change status",
    "change_impacts": "many impacted records per change request, typed target IDs with exact requirement revision when applicable; closures require disposition and evidence",
    "standards_profiles": "user-owned per-product standard edition, scope, reviewer and tailoring; none are automatically active or compliance certifications"
  }
}
