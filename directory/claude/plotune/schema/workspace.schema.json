{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable requirements workspace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "canonical_backend",
    "location"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string"
    },
    "canonical_backend": {
      "type": "string",
      "enum": [
        "plotune-rms",
        "google-sheets",
        "sqlite",
        "csv"
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "Local path, user-owned spreadsheet URL, or RMS project address. Never embed tokens."
    },
    "last_verified_at_utc": {
      "type": "string"
    },
    "maturity_model_ref": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
